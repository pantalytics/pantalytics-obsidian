{
	"name": "pantalytics",
	"version": "1.13.50",
	"description": "Sync your whole vault with your Pantalytics workspace, on desktop and phone, and edit together in real time.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs watch",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"release": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"beta": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs debug",
		"staging": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs staging",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"test": "jest",
		"lint": "npx eslint src/"
	},
	"keywords": [
		"obsidian",
		"collaboration",
		"relay",
		"real-time",
		"enterprise"
	],
	"author": "Pantalytics",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pantalytics/pantalytics-obsidian.git"
	},
	"bugs": {
		"url": "https://github.com/pantalytics/pantalytics-obsidian/issues"
	},
	"homepage": "https://github.com/pantalytics/pantalytics-obsidian",
	"devDependencies": {
		"@codemirror/state": "^6.6.0",
		"@codemirror/view": "^6.43.0",
